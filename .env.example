# Copia este archivo como .env y rellena los valores. El .env NUNCA se sube a git.
#
# Las variables que empiezan por EXPO_PUBLIC_ acaban dentro de la app (cualquiera podría
# leerlas), así que solo pueden ser claves pensadas para ser públicas. La "anon key" de
# Supabase lo es: lo que protege los datos son las reglas RLS de la base de datos.
# La clave "service_role" de Supabase JAMÁS va aquí: solo en las Edge Functions.

# Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps para Android (Google Cloud > Credenciales), restringida a app.rotllo
GOOGLE_MAPS_ANDROID_API_KEY=
